{
  "name": "kiiro-games",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "party:dev": "wrangler dev",
    "party:deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "sim": "tsx scripts/mahjong/sim.ts",
    "test": "tsx scripts/tools/run-tests.ts engine",
    "check": "tsc --noEmit && prettier --check . && npm test",
    "test:mahjong": "sh scripts/mahjong/run-engine-suite.sh",
    "test:holdem": "tsx scripts/holdem/engine-test.ts",
    "test:blackjack": "tsx scripts/blackjack/engine-test.ts",
    "test:bigtwo": "tsx scripts/bigtwo/engine-test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:server": "tsx scripts/tools/run-tests.ts server",
    "test:browser": "tsx scripts/tools/run-tests.ts browser"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "prettier": "3.10.1",
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "wrangler": "^4.163.0"
  }
}
